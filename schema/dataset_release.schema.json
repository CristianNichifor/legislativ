{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public dataset release v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "created_at", "app_contract", "files"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "release": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(-[A-Za-z0-9][A-Za-z0-9._-]{0,63})?$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "app_contract": {"type": "integer", "const": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "uniqueItems": true,
      "contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "corpus.db"}}},
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "bytes", "sha256"],
        "properties": {
          "name": {"enum": ["corpus.db", "initiative.db", "graf.db", "eu.db", "index.json", "termeni.json", "manifest.json", "vid.json", "neconstitutional.json", "norme_lovite.json", "considerente.json", "parlament.json", "ue_acoperire.json"]},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "if": {"properties": {"name": {"enum": ["corpus.db", "initiative.db", "graf.db", "eu.db"]}}},
        "else": {"properties": {"bytes": {"maximum": 4194304}}}
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manifest", "sha256"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "manifest": {"type": "string", "format": "uri", "pattern": "^https://[^/?#@]+/[0-9]{4}-[0-9]{2}-[0-9]{2}(-[A-Za-z0-9][A-Za-z0-9._-]{0,63})?/dataset-release\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
