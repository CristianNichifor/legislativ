{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded V1 acceptance pilot provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "status", "domain", "sources", "excluded", "synthetic_controls"],
  "properties": {
    "$schema": {"type": "string"},
    "status": {"enum": ["proposed_pending_user_domain_approval", "approved"]},
    "domain": {"type": "string", "minLength": 1},
    "excluded": {"type": "array", "items": {"type": "string"}},
    "synthetic_controls": {"type": "array", "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["act_id", "path", "sha256", "kind", "source_url", "url_evidence",
                     "retrieved_at", "retrieval_time_status"],
        "properties": {
          "act_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^sources/[^/]+[.]html[.]gz$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "kind": {"enum": ["authentic_retrieved_portal_snapshot", "synthetic"]},
          "source_url": {"type": ["string", "null"]},
          "url_evidence": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": ["string", "null"]},
          "retrieval_time_status": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
