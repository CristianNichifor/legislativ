{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parliament project snapshots",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "snapshots"],
  "properties": {
    "$schema": {"type": "string"},
    "contract": {"const": "parliament-project-snapshots-v1"},
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "family",
          "project_id",
          "idp",
          "chamber",
          "senate_id",
          "source_url",
          "snapshot_path",
          "snapshot_sha256",
          "procedure_date",
          "stage_contains",
          "title_contains",
          "notes"
        ],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9_.:-]+$"},
          "family": {"enum": ["camera", "senat", "parlament"]},
          "project_id": {"type": "string", "minLength": 1},
          "idp": {"type": "string", "pattern": "^[0-9]+$"},
          "chamber": {"type": "string", "minLength": 1},
          "senate_id": {"type": ["string", "null"]},
          "source_url": {"type": "string", "pattern": "^https://www\\.cdep\\.ro/"},
          "snapshot_path": {"type": "string", "minLength": 1},
          "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "procedure_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "stage_contains": {"type": "string", "minLength": 1},
          "title_contains": {"type": "string", "minLength": 1},
          "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
