{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V1 acceptance dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "status", "version", "scope", "items", "acceptance_checks"],
  "properties": {
    "$schema": {"type": "string"},
    "contract": {"const": "v1-acceptance-dataset-manifest-v1"},
    "status": {"enum": ["baseline"]},
    "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "includes",
        "excludes",
        "max_checked_in_payload_bytes",
        "large_release_required"
      ],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "includes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "excludes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "max_checked_in_payload_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "large_release_required": {"const": false}
      }
    },
    "items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_family",
          "record_type",
          "mode",
          "identifier",
          "title",
          "official_url",
          "local_path",
          "sha256",
          "v1_role",
          "acceptance_status"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^v1-[a-z0-9-]+$"},
          "source_family": {
            "enum": [
              "portal_legislativ",
              "camera",
              "senat",
              "econsultare",
              "ministry_consultation",
              "eu_cellar"
            ]
          },
          "record_type": {"enum": ["law", "project", "consultation", "celex"]},
          "mode": {"enum": ["local_fixture", "placeholder"]},
          "identifier": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "official_url": {"type": ["string", "null"]},
          "local_path": {"type": ["string", "null"], "pattern": "^sources/[^/]+[.]html[.]gz$"},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "v1_role": {
            "enum": [
              "primary_law_text",
              "secondary_law_text",
              "project_lifecycle",
              "public_consultation",
              "eu_reference"
            ]
          },
          "acceptance_status": {"enum": ["available", "placeholder", "text_missing"]}
        },
        "allOf": [
          {
            "if": {"properties": {"mode": {"const": "local_fixture"}}, "required": ["mode"]},
            "then": {
              "properties": {
                "local_path": {"type": "string"},
                "sha256": {"type": "string"},
                "acceptance_status": {"const": "available"}
              }
            }
          },
          {
            "if": {"properties": {"mode": {"const": "placeholder"}}, "required": ["mode"]},
            "then": {
              "properties": {
                "local_path": {"type": "null"},
                "sha256": {"type": "null"}
              }
            }
          }
        ]
      }
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
