__pycache__/
test-results/
test-results-static/
playwright-report/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
/.context-fixture/
/.eu-link-fixture/
/.browser-generation-fixture/

# Fetched pages. The parser's fixtures are the exception and are un-ignored by name in
# sources/README.md's terms — a parser test against a page nobody else can fetch is not a test.
sources/*.html
sources/*.html.gz
# Except the parser's fixtures. A parser tested only against markup invented alongside it has
# never been tested, and these two pages are what every selector in scripts/parsare.py was read
# off. 229 KB gzipped, and the portal refuses GitHub Actions runners, so CI could not fetch
# them even if it were willing to.
!sources/lege-98-2016.html.gz
!sources/decizie-815-2015.html.gz
!sources/lege-310-2021.html.gz
# The amending-act fixture the other three lacked: Legea 208/2022 amends Legea 98/2016 and
# supplies each replacement in an `S_CIT` block. It is the answer key for consolidation — a
# payload it quotes must equal the portal's own consolidated text of the article it replaces —
# and that gold test cannot exist without the page committed. 36 KB gzipped.
!sources/lege-208-2022.html.gz

# The corpus and its HTTP cache, once there is one. Re-fetchable by definition, and the reason
# this package is its own repository rather than a directory in a monorepo with a size gate.
cache/
corpus/
# The built corpus itself: ~1 GB of SQLite, rebuilt by scripts/colector.py from the API.
# It is an artifact, not source; a release asset if it needs sharing, never a committed blob.
corpus.db
corpus.db-*
# every sqlite artifact — the corpus, the initiatives, their WAL/SHM sidecars.
# Built by the collectors from the API; a release asset if shared, never a committed blob.
*.db
# …and the hand-made checkpoints beside them, which the rules above did not cover.
# `graf.db-inainte-de-imbogatire`, `graf.db.vechi`, `initiative.db-inainte-de-stenograme`:
# copies taken before a risky rebuild, named after what they precede. Nine of them were
# sitting untracked and unignored in a working clone, 855 MB between them, which means
# `git add -A` staged 855 MB of SQLite and `git status` was unreadable.
#
# That is not hypothetical here. `initiative.db` and `initiative.db-wal` are in this
# repository's history — 11.6 MB across two commits — from before the rules above existed.
# These two patterns cover the naming actually in use and subsume the -shm/-wal cases.
*.db-*
*.db.*

# Release artifacts: gzipped databases for a GitHub release, not source.
dist/

# The browser build (scripts/construieste_web.py). All regenerable from the corpus + app/ + the
# scripts package, and the data slice is tens of MB — the build script is the source, not these.
web/data/
web/bundle.zip
web/index.html
web/worker.js
web/browser-workspace.js
web/browser-generation.js
web/dataset-updates.js
web/sw.js
# copied here from app/fonts/ by the build; app/fonts/ is the committed source
web/fonts/
web/civic-ui-adapter.css
web/vendor/civic-ui/

# jurnalul colectării supravegheate
colector-supravegheat.log
corpus-final.db
graf-vechi.db
graf-build.log
colector-4w.log

# Generat de infra/pagefind.mjs; indexul se publică în depozit, nu în git. Ancorate la rădăcină,
# altfel ar înghiți și app/pagefind/, care e clientul și trebuie să fie în git.
/pagefind/
/pagefind-*/
/web/pagefind/
# Doar pentru indexare: `pagefind` e adus din npm, nu e o dependență a aplicației.
node_modules/

# Local agent state. `.claude/` is scoped to worktrees rather than ignored whole, so shared
# project configuration can still be committed there; `.omc/` is session and memory state with
# no shared half. 77 MB and 40 KB respectively in the clone this was written from.
.claude/worktrees/
.omc/
